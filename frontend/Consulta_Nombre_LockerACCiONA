<body>

<div class="container">

    <div class="logo-area">
        <h1>ACCIONA</h1>
        <p>Consulta de Persona</p>
    </div>

    <h2>Buscar por Locker</h2>

    <p class="instruccion">
        Ingresa el número del locker para conocer quién lo tiene asignado.
    </p>

    <div class="input-group">

        <input
            type="text"
            id="lockerInput"
            placeholder="Ej: 152"
            autocomplete="off"
            maxlength="100"
            inputmode="numeric"
            aria-label="Número de locker"
        >

        <button
            type="button"
            id="btnConsultar"
            onclick="buscarPorLocker()"
        >
            Consultar
        </button>

    </div>

    <p class="ayuda-locker">
        Ejemplo: 152
    </p>

    <div
        id="resultado"
        class="resultado"
        aria-live="polite"
    ></div>

</div>

<script>

const API_URL = 'https://locker-app.onrender.com/api';

// =====================================================
// NORMALIZAR LOCKER
// =====================================================

function normalizarLocker(valor) {

    return String(valor || '')
        .trim()
        .replace(/\s+/g, '');
}


// =====================================================
// BUSCAR USUARIO POR LOCKER
// =====================================================

async function buscarPorLocker() {

    const lockerInput =
        document.getElementById('lockerInput');

    const divResultado =
        document.getElementById('resultado');

    const btnConsultar =
        document.getElementById('btnConsultar');

    const locker =
        normalizarLocker(lockerInput.value);

    lockerInput.value = locker;


    // =================================================
    // VALIDAR
    // =================================================

    if (!locker) {

        mostrarError(
            '⚠️ Ingresa un número de locker para realizar la consulta.'
        );

        lockerInput.focus();

        return;
    }


    // =================================================
    // MOSTRAR CARGANDO
    // =================================================

    divResultado.style.display = 'block';

    divResultado.innerHTML = `

        <div class="loading-box">

            <div class="icono">🔎</div>

            <p class="loading">
                Consultando información del locker...
            </p>

        </div>

    `;


    btnConsultar.disabled = true;

    btnConsultar.textContent = 'Consultando...';


    // =================================================
    // CONSULTAR API
    // =================================================

    try {

        const respuesta = await fetch(

            `${API_URL}/usuarios/locker/${encodeURIComponent(locker)}`

        );


        let datos = {};

        try {

            datos = await respuesta.json();

        } catch (_) {

            datos = {};

        }


        // =================================================
        // LOCKER NO ENCONTRADO
        // =================================================

        if (respuesta.status === 404) {

            mostrarNoEncontrado();

            return;
        }


        // =================================================
        // OTRO ERROR
        // =================================================

        if (!respuesta.ok) {

            mostrarError(

                datos.mensaje ||
                datos.error ||
                'No se pudo realizar la consulta. Inténtalo nuevamente.'

            );

            return;
        }


        // =================================================
        // MOSTRAR USUARIO
        // =================================================

        mostrarUsuario(datos);

    }

    catch (error) {

        console.error(error);

        mostrarError(

            '❌ No se pudo conectar con el servidor. Revisa tu conexión e inténtalo nuevamente.'

        );

    }

    finally {

        btnConsultar.disabled = false;

        btnConsultar.textContent = 'Consultar';
    }
}


// =====================================================
// MOSTRAR DATOS DEL USUARIO
// =====================================================

function mostrarUsuario(datos) {

    const divResultado =
        document.getElementById('resultado');


    const tieneLocker =
        Boolean(datos.locker);

    const tieneBolsa =
        Boolean(datos.bolsa);

    const tieneCandado =
        Boolean(datos.candado);


    const completo =
        tieneLocker &&
        tieneBolsa &&
        tieneCandado;


    divResultado.innerHTML = `

        <h3>
            ✓ Persona encontrada
        </h3>


        <div class="estado ${completo ? 'ok' : 'pendiente'}">

            ${
                completo
                    ? '🟢 La información está completa.'
                    : '🟡 Hay información que todavía no está asignada.'
            }

        </div>


        <!-- RUT -->

        <div class="dato destacado">

            <strong>
                RUT
            </strong>

            <div class="valor">

                ${escapeHtml(datos.rut)}

            </div>

        </div>


        <!-- NOMBRE -->

        <div class="dato">

            <strong>
                Nombre
            </strong>

            <div class="valor">

                ${escapeHtml(datos.nombre)}

            </div>

        </div>


        <!-- LOCKER -->

        <div class="dato destacado">

            <strong>
                Locker
            </strong>

            <div class="valor">

                ${escapeHtml(datos.locker)}

            </div>

        </div>


        <!-- BOLSA -->

        <div class="dato destacado">

            <strong>
                Número de bolsa
            </strong>

            <div class="valor ${
                tieneBolsa
                    ? ''
                    : 'sin-asignar'
            }">

                ${
                    tieneBolsa
                        ? escapeHtml(datos.bolsa)
                        : '⚠️ Sin asignar'
                }

            </div>

        </div>


        <!-- CANDADO -->

        <div class="dato destacado">

            <strong>
                Número de candado
            </strong>

            <div class="valor ${
                tieneCandado
                    ? ''
                    : 'sin-asignar'
            }">

                ${
                    tieneCandado
                        ? escapeHtml(datos.candado)
                        : '⚠️ Sin asignar'
                }

            </div>

        </div>


        <button
            type="button"
            class="btn-nueva"
            onclick="nuevaConsulta()"
        >
            🔎 Nueva consulta
        </button>

    `;


    divResultado.style.display = 'block';
}


// =====================================================
// LOCKER NO ENCONTRADO
// =====================================================

function mostrarNoEncontrado() {

    const divResultado =
        document.getElementById('resultado');


    divResultado.style.display = 'block';


    divResultado.innerHTML = `

        <div class="error-box">

            <div class="icono">
                🔎
            </div>

            <p>

                <strong>
                    No encontramos ninguna persona con ese locker.
                </strong>

            </p>

            <p style="margin-top:8px;">

                Verifica que el número del locker sea correcto
                o que actualmente esté asignado.

            </p>

        </div>

    `;
}


// =====================================================
// MOSTRAR ERROR
// =====================================================

function mostrarError(texto) {

    const divResultado =
        document.getElementById('resultado');


    divResultado.style.display = 'block';


    divResultado.innerHTML = `

        <div class="error-box">

            <div class="icono">
                ⚠️
            </div>

            <p class="error">

                ${escapeHtml(texto)}

            </p>

        </div>

    `;
}


// =====================================================
// NUEVA CONSULTA
// =====================================================

function nuevaConsulta() {

    const lockerInput =
        document.getElementById('lockerInput');

    const divResultado =
        document.getElementById('resultado');


    lockerInput.value = '';

    divResultado.innerHTML = '';

    divResultado.style.display = 'none';

    lockerInput.focus();
}


// =====================================================
// PROTECCIÓN HTML
// =====================================================

function escapeHtml(valor) {

    if (
        valor === null ||
        valor === undefined
    ) {

        return '';

    }


    return String(valor)

        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}


// =====================================================
// ENTER PARA CONSULTAR
// =====================================================

document
    .getElementById('lockerInput')
    .addEventListener(
        'keydown',
        function(event) {

            if (event.key === 'Enter') {

                event.preventDefault();

                buscarPorLocker();

            }

        }
    );


// =====================================================
// LIMPIAR CARACTERES NO NUMÉRICOS
// =====================================================

document
    .getElementById('lockerInput')
    .addEventListener(
        'input',
        function() {

            this.value =
                this.value.replace(/\D/g, '');

        }
    );

</script>

</body>
</html>
